<%- include('partials/head') %>
    <section class="page-top">
        <div>
            <p class="eyebrow">Customer space</p>
            <h1>Your parcels,<br><em>in motion.</em></h1>
            <p class="muted">Book, track, and stay one step ahead.</p>
        </div><a class="button button-red" href="/parcels/book">Book a parcel <span>↗</span></a>
    </section>
    <section class="stats-grid">
        <div class="stat-card"><span>Total parcels</span><strong>
                <%= stats.total %>
            </strong><small>Booked with us</small></div>
        <div class="stat-card"><span>In motion</span><strong>
                <%= stats.active %>
            </strong><small>Not yet delivered</small></div>
        <div class="stat-card"><span>Delivered</span><strong class="green-text">
                <%= stats.delivered %>
            </strong><small>Successfully arrived</small></div>
    </section>
    <section class="content-section">
        <div class="section-heading inline-heading">
            <div>
                <p class="eyebrow">Shipment history</p>
                <h2>Follow every<br><em>handoff.</em></h2>
            </div>
        </div>
        <div class="parcel-list">
            <% if (!parcels.length) { %>
                <div class="empty-state">No parcels yet. Book your first delivery to get a tracking ID.</div>
                <% } %>
                    <% parcels.forEach(parcel=> { %><a class="parcel-row" href="/track/<%= parcel.trackingId %>">
                            <div class="tracking-badge">
                                <%= parcel.trackingId.slice(-4) %>
                            </div>
                            <div><strong>
                                    <%= parcel.trackingId %>
                                </strong>
                                <p>
                                    <%= parcel.receiver.name %> · <%= parcel.dropAddress %>
                                </p>
                            </div><span class="status-pill">
                                <%= parcel.status %>
                            </span><time>
                                <%= new Date(parcel.createdAt).toLocaleDateString('en-IN', { day: 'numeric' ,
                                    month: 'short' }) %>
                            </time>
                        </a>
                        <% }) %>
        </div>
    </section><%- include('partials/foot') %>