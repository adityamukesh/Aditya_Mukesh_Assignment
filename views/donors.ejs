<%- include('partials/head') %>
    <section class="page-top compact">
        <div>
            <p class="eyebrow">Community</p>
            <h1>Donor<br><em>directory.</em></h1>
        </div><a class="button button-outline" href="/admin">← Back to overview</a>
    </section>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Donor</th>
                    <th>Blood group</th>
                    <th>Location</th>
                    <th>Last donation</th>
                    <th>Eligibility</th>
                </tr>
            </thead>
            <tbody>
                <% donors.forEach(donor=> { const days = donor.lastDonation ? Math.floor((Date.now() - new
                    Date(donor.lastDonation).getTime()) / 86400000) : 999; %><tr>
                        <td><strong>
                                <%= donor.name %>
                            </strong><small>
                                <%= donor.email %>
                            </small></td>
                        <td><span class="request-badge">
                                <%= donor.bloodGroup %>
                            </span></td>
                        <td>
                            <%= donor.city %>
                        </td>
                        <td>
                            <%= donor.lastDonation ? new Date(donor.lastDonation).toLocaleDateString('en-IN', {
                                day: 'numeric' , month: 'short' , year: 'numeric' }) : 'First-time donor' %>
                        </td>
                        <td><span class="status-pill <%= days >= 90 ? 'good' : '' %>">
                                <%= days>= 90 ? 'Eligible' : 'Waiting' %>
                            </span></td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div><%- include('partials/foot') %>