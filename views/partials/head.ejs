<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> · LifeLink
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <header class="site-header">
        <a class="brand" href="/"><span class="brand-mark">+</span><span>lifelink<span
                    class="brand-dot">.</span></span></a>
        <nav class="nav-links">
            <a href="/search" class="<%= path === '/search' ? 'active' : '' %>">Find blood</a>
            <% if (currentUser) { %><a
                    href="<%= currentUser.role === 'admin' ? '/admin' : '/dashboard' %>">Dashboard</a>
                <% } %>
                    <a href="/request" class="nav-urgent">Emergency request <span>↗</span></a>
                    <% if (currentUser) { %>
                        <form method="post" action="/logout"><button class="nav-logout" type="submit">Sign out</button>
                        </form>
                        <% } else { %><a href="/login">Sign in</a>
                            <% } %>
        </nav>
        <button class="menu-button" aria-label="Open menu">☰</button>
    </header>
    <main>