<%- include('partials/head') %>
    <section class="page-top compact">
        <div>
            <p class="eyebrow">Blood bank inventory</p>
            <h1>Find the right<br><em>match.</em></h1>
        </div><a href="/request" class="button button-red">Need blood urgently? <span>↗</span></a>
    </section>
    <section class="filter-row">
        <p>Showing <strong>
                <%= selected || 'all groups' %>
            </strong></p>
        <div class="filter-pills"><a class="filter-pill <%= !selected ? 'selected' : '' %>" href="/search">All</a>
            <% groups.forEach(group=> { %><a class="filter-pill <%= selected === group ? 'selected' : '' %>"
                    href="/search?group=<%= group %>">
                    <%= group %>
                </a>
                <% }) %>
        </div>
    </section>
    <div class="inventory-grid">
        <% inventory.forEach(item=> { %><div class="inventory-card">
                <div class="inventory-card-top"><span class="blood-type large">
                        <%= item.bloodGroup %>
                    </span><span class="stock-label <%= item.units < item.target ? 'low' : '' %>">
                        <%= item.units < item.target ? 'Low stock' : 'In stock' %>
                    </span></div><strong>
                    <%= item.units %>
                </strong>
                <p>units currently available</p>
                <div class="stock-bar"><i style="width:<%= Math.min(item.units / item.target * 100, 100) %>%"></i></div>
                <small>Target: <%= item.target %> units</small>
            </div>
            <% }) %>
    </div><%- include('partials/foot') %>