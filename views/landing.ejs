<%- include('partials/head') %>
    <section class="hero">
        <div class="hero-copy">
            <p class="eyebrow">Logistics, made human</p>
            <h1>Move what<br><em>matters.</em></h1>
            <p class="hero-lead">Book parcels, follow every handoff, and keep customers in the loop from pickup to
                doorstep.</p>
            <div class="hero-actions"><a class="button button-dark" href="/register">Book a parcel <span>↗</span></a><a
                    class="text-link" href="#track">Track a shipment <span>→</span></a></div>
            <div class="hero-proof"><span class="proof-number">24/7</span>
                <p>clear tracking<br>for every delivery</p>
            </div>
        </div>
        <div class="hero-art">
            <div class="route-line"></div>
            <div class="route-dot dot-one">A</div>
            <div class="route-dot dot-two">B</div>
            <div class="parcel-visual"><span>▣</span><strong>LL 4829</strong><small>In transit</small></div>
            <div class="art-label">On the way <span>✦</span></div>
        </div>
    </section>
    <section class="impact-strip">
        <div><span class="impact-number">6</span><span>delivery stages<br>tracked live</span></div>
        <div><span class="impact-number">3</span><span>roles, one<br>shared workflow</span></div>
        <div><span class="impact-number">1</span><span>tracking ID<br>per parcel</span></div>
        <div class="impact-note">From booking<br>to delivered.</div>
    </section>
    <section class="track-band" id="track">
        <div>
            <p class="eyebrow">Already shipped?</p>
            <h2>Track the journey.</h2>
        </div>
        <form action="/track" method="get"><input name="trackingId" placeholder="Enter tracking ID" required><button
                class="button button-red" type="submit">Track parcel <span>→</span></button></form>
    </section>
    <section class="feature-section">
        <div class="section-heading">
            <p class="eyebrow">One clear system</p>
            <h2>Less chasing.<br><em>More arriving.</em></h2>
        </div>
        <div class="feature-grid">
            <div class="feature-card"><span class="feature-index">01</span>
                <h3>Book in minutes</h3>
                <p>Capture sender, receiver, addresses, weight, and parcel type in one focused flow.</p>
            </div>
            <div class="feature-card peach"><span class="feature-index">02</span>
                <h3>See every handoff</h3>
                <p>A timestamped status history keeps customers, agents, and admins aligned.</p>
            </div>
            <div class="feature-card dark"><span class="feature-index">03</span>
                <h3>Operate with clarity</h3>
                <p>Assign agents, manage zones, and watch the delivery load from one dashboard.</p>
            </div>
        </div>
    </section>
    <%- include('partials/foot') %>