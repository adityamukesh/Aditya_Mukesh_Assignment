<%- include('partials/head') %>
    <section class="auth-shell">
        <div class="auth-intro">
            <p class="eyebrow">Welcome to LifeLink</p>
            <h1>Good to see<br><em>you again.</em></h1>
            <p>Sign in to track your donations, find available blood, or help manage your local blood bank.</p>
        </div>
        <form class="form-panel" method="post" action="/login">
            <h2>Sign in</h2>
            <% if (error) { %>
                <div class="alert alert-error">
                    <%= error %>
                </div>
                <% } %><label>Email address<input type="email" name="email" placeholder="you@example.com"
                            required></label><label>Password<input type="password" name="password"
                            placeholder="••••••••" required></label><button class="button button-dark button-full"
                        type="submit">Continue <span>↗</span></button>
                    <p class="form-foot">New to LifeLink? <a href="/register">Create an account</a></p>
        </form>
    </section><%- include('partials/foot') %>