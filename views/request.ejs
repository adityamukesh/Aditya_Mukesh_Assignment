<%- include('partials/head') %>
    <section class="request-shell">
        <div class="request-intro">
            <p class="eyebrow">New shipment</p>
            <h1>Send it<br><em>forward.</em></h1>
            <p>Tell us where it starts, where it is going, and what is inside. We will return a tracking ID instantly.
            </p>
            <div class="emergency-note"><span>✦</span>
                <p><strong>Every handoff is recorded.</strong><br>Customers and agents see the same timeline.</p>
            </div>
        </div>
        <form class="form-panel request-form" method="post" action="/parcels">
            <h2>Parcel details</h2>
            <div class="form-grid"><label>Sender name<input name="senderName" required
                        placeholder="Full name"></label><label>Sender phone<input name="senderPhone" required
                        placeholder="Phone number"></label></div>
            <div class="form-grid"><label>Receiver name<input name="receiverName" required
                        placeholder="Full name"></label><label>Receiver phone<input name="receiverPhone" required
                        placeholder="Phone number"></label></div><label>Pickup address<input name="pickupAddress"
                    required placeholder="Where should we collect it?"></label><label>Drop address<input
                    name="dropAddress" required placeholder="Where should we deliver it?"></label>
            <div class="form-grid triple"><label>Weight (kg)<input type="number" name="weight" min="0.1" step="0.1"
                        required placeholder="1.0"></label><label>Parcel type<select name="parcelType">
                        <% parcelTypes.forEach(type=> { %><option>
                                <%= type %>
                            </option>
                            <% }) %>
                    </select></label><label>Delivery zone<input name="zone" placeholder="Central"></label></div><button
                class="button button-red button-full" type="submit">Book parcel <span>↗</span></button>
        </form>
    </section><%- include('partials/foot') %>