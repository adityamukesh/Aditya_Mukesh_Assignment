<%- include('partials/head') %>
    <section class="page-top">
        <div>
            <p class="eyebrow">Operations control</p>
            <h1>Keep the city<br><em>moving.</em></h1>
            <p class="muted">Assign, monitor, and resolve every delivery.</p>
        </div>
    </section>
    <% if (success) { %>
        <div class="alert alert-success">
            <%= success %>
        </div>
        <% } %>
            <section class="stats-grid">
                <div class="stat-card"><span>Total parcels</span><strong>
                        <%= stats.total %>
                    </strong><small>All bookings</small></div>
                <div class="stat-card"><span>In transit</span><strong>
                        <%= stats.transit %>
                    </strong><small>On the road</small></div>
                <div class="stat-card"><span>Delivered</span><strong class="green-text">
                        <%= stats.delivered %>
                    </strong><small>Successfully arrived</small></div>
                <div class="stat-card"><span>Failed</span><strong class="red-text">
                        <%= stats.failed %>
                    </strong><small>Needs review</small></div>
            </section>
            <section class="admin-columns">
                <div class="admin-panel">
                    <div class="panel-heading">
                        <div>
                            <p class="eyebrow">Dispatch board</p>
                            <h2>Parcel assignments</h2>
                        </div>
                    </div>
                    <% parcels.forEach(parcel=> { %><div class="admin-request">
                            <div class="tracking-badge">
                                <%= parcel.trackingId.slice(-4) %>
                            </div>
                            <div class="request-main"><strong>
                                    <%= parcel.trackingId %>
                                </strong>
                                <p>
                                    <%= parcel.pickupAddress %> → <%= parcel.dropAddress %>
                                </p><span class="status-pill">
                                    <%= parcel.status %>
                                </span>
                            </div>
                            <form method="post" action="/admin/parcels/<%= parcel._id %>/assign"><select name="agentId"
                                    required>
                                    <option value="">Assign agent</option>
                                    <% agents.forEach(agent=> { %><option value="<%= agent._id %>"
                                            <%=parcel.assignedAgent &&
                                            String(parcel.assignedAgent._id)===String(agent._id) ? 'selected' : '' %>>
                                            <%= agent.name %>
                                        </option>
                                        <% }) %>
                                </select><button class="button button-dark" type="submit">Assign</button></form>
                        </div>
                        <% }) %>
                </div>
                <div class="admin-panel">
                    <div class="panel-heading">
                        <div>
                            <p class="eyebrow">Network</p>
                            <h2>Agents and zones</h2>
                        </div>
                    </div>
                    <div class="mini-form">
                        <h3>Add agent</h3>
                        <form method="post" action="/admin/agents"><input name="name" placeholder="Name" required><input
                                type="email" name="email" placeholder="Email" required><input name="phone"
                                placeholder="Phone"><input type="password" name="password" placeholder="Password"
                                required><input name="vehicle" placeholder="Vehicle"><input name="zone"
                                placeholder="Zone"><button class="button button-red" type="submit">Create agent</button>
                        </form>
                    </div>
                    <div class="mini-form">
                        <h3>Add delivery zone</h3>
                        <form method="post" action="/admin/zones"><input name="name" placeholder="Zone name"
                                required><input name="city" placeholder="City"><button class="button button-outline"
                                type="submit">Add zone</button></form>
                    </div>
                    <div class="zone-list">
                        <% zones.forEach(zone=> { %><span class="filter-pill">
                                <%= zone.name %>
                            </span>
                            <% }) %>
                    </div>
                </div>
            </section><%- include('partials/foot') %>